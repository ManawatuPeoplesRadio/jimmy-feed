<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Latest Jimmy Ellingham Stories</title>
<style>
body{
font-family:Arial,sans-serif;
margin:0;
padding:20px;
}
.story{
padding:15px;
margin-bottom:12px;
border:1px solid #ddd;
border-radius:8px;
background:#fff;
}
.story a{
color:#0066cc;
font-weight:bold;
text-decoration:none;
}
</style>
</head>
<body>
<div id="feed">Loading...</div>
<script>
fetch('./stories.json')
.then(r => r.json())
.then(stories => {
document.getElementById('feed').innerHTML =
stories.map(story => `
<div class="story">
${story.url}
${story.title}
</a>
</div>
`).join('');
});
</script>
</body>
</html>
